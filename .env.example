# Supabase (public — aman di browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA di server (dipakai untuk membaca ai_personas tanpa system_prompt). Jangan beri prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL situs untuk redirect email/OAuth (opsional, default: origin request)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = pakai mock chat lokal (src/lib/mock-chat.ts) selama endpoint /api/chat belum tersedia
NEXT_PUBLIC_USE_MOCK_CHAT=true

# Untuk `npm run gen:types`
SUPABASE_PROJECT_ID=
